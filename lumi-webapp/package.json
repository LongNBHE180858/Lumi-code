{
  "name": "lumi",
  "version": "0.0.1-SNAPSHOT",
  "private": true,
  "description": "Description for Lumi",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "npm run webapp:prod --",
    "build-watch": "concurrently 'npm run webapp:build:dev -- --watch'",
    "ci:e2e:dev": "concurrently -k -s first -n application,e2e -c red,blue npm:app:start npm:e2e:headless",
    "ci:e2e:run": "concurrently -k -s first -n application,e2e -c red,blue npm:ci:e2e:server:start npm:e2e:headless",
    "ci:frontend:test": "npm run webapp:build:$npm_package_config_default_environment && npm run test",
    "clean-www": "rimraf target/classes/static/",
    "cleanup": "rimraf target/",
    "e2e": "npm run e2e:playwright:headed --",
    "e2e:dev": "concurrently -k -s first -n application,e2e -c red,blue npm:app:start npm:e2e",
    "e2e:devserver": "concurrently -k -s first -n backend,frontend,e2e -c red,yellow,blue npm:backend:start npm:start \"wait-on -t 180000 http-get://127.0.0.1:9000 && E2E_BASE_URL=http://localhost:9000 npm run e2e:headless\"",
    "pree2e:headless": "npm run ci:server:await --if-present",
    "e2e:headless": "npm run e2e:playwright --",
    "pree2e:playwright": "npm run playwright:install",
    "e2e:playwright": "playwright test --project=chromium",
    "e2e:playwright:headed": "npm run e2e:playwright -- --headed",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "playwright": "playwright test --ui",
    "playwright:install": "playwright install chromium",
    "prepare": "husky",
    "prettier:check": "prettier --check \"{,.blueprint/**/,src/**/}*.{md,json,yml,js,cjs,mjs,ts,cts,mts,java,html,tsx,css,scss}\"",
    "prettier:format": "prettier --write \"{,.blueprint/**/,src/**/}*.{md,json,yml,js,cjs,mjs,ts,cts,mts,java,html,tsx,css,scss}\"",
    "sonar": "sonar-scanner",
    "start": "npm run webapp:dev --",
    "pretest": "npm run lint",
    "test": "npm run vitest-run --",
    "test:watch": "npm run vitest --",
    "vitest": "vitest",
    "vitest-run": "vitest run --coverage",
    "watch": "concurrently 'npm run start' npm:backend:start",
    "webapp:build": "npm run clean-www && npm run webapp:build:dev --",
    "webapp:build:dev": "vite build",
    "webapp:build:prod": "vite build",
    "webapp:dev": "vite",
    "webapp:prod": "npm run clean-www && npm run webapp:build:prod --",
    "webapp:test": "npm run test --"
  },
  "config": {
    "default_environment": "prod"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@reduxjs/toolkit": "2.12.0",
    "axios": "1.20.0",
    "bootstrap": "5.3.8",
    "dayjs": "1.11.23",
    "lucide-react": "^1.60.0",
    "react": "19.3.0",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-jhipster": "1.1.0",
    "react-redux": "9.3.0",
    "react-router": "8.3.1",
    "react-toastify": "11.1.0",
    "react-top-loading-bar": "3.0.2",
    "redux": "5.0.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.19.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "autoprefixer": "10.6.0",
    "concurrently": "10.0.5",
    "deepmerge": "4.3.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-prettier": "5.5.6",
    "generator-jhipster": "9.4.0",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "3.0.2",
    "react-infinite-scroll-component": "7.2.1",
    "rimraf": "6.1.3",
    "sass": "1.77.6",
    "sonar-scanner": "3.1.0",
    "swagger-ui-dist": "5.32.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.0.0",
    "vitest-sonar-reporter": "3.0.0",
    "wait-on": "9.1.0"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "allowScripts": {
    "@playwright/test": true
  }
}
