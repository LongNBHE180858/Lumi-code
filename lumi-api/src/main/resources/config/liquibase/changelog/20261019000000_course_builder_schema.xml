<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="20261019000000-1" author="codex">
        <addColumn tableName="course">
            <column name="short_description" type="varchar(1000)"/>
            <column name="book_series" type="varchar(100)"/>
            <column name="target_audience" type="varchar(1000)"/>
            <column name="prerequisites" type="varchar(1000)"/>
            <column name="learning_objectives" type="jsonb"/>
            <column name="intro_video_url" type="varchar(1000)"/>
            <column name="access_duration_value" type="integer"/>
            <column name="access_duration_unit" type="varchar(10)"/>
            <column name="version" type="bigint" defaultValueNumeric="0"/>
        </addColumn>
        <addColumn tableName="lesson">
            <column name="description" type="text"/>
            <column name="video_url" type="varchar(1000)"/>
            <column name="video_file_name" type="varchar(255)"/>
            <column name="video_size_bytes" type="bigint"/>
        </addColumn>
        <addColumn tableName="course_material">
            <column name="file_name" type="varchar(255)"/>
            <column name="display_name" type="varchar(255)"/>
            <column name="mime_type" type="varchar(100)"/>
            <column name="order_index" type="integer"/>
        </addColumn>
        <dropNotNullConstraint tableName="course" columnName="valid_duration_days" columnDataType="integer"/>
        <update tableName="course"><column name="access_duration_value" valueComputed="valid_duration_days"/><column name="access_duration_unit" value="DAY"/><where>valid_duration_days IS NOT NULL</where></update>
        <addNotNullConstraint tableName="course" columnName="version" columnDataType="bigint"/>
        <createTable tableName="course_review_requests">
            <column name="id" type="bigint"><constraints nullable="false" primaryKey="true"/></column>
            <column name="course_id" type="bigint"><constraints nullable="false"/></column>
            <column name="submitted_by_id" type="bigint"><constraints nullable="false"/></column>
            <column name="reviewed_by_id" type="bigint"><constraints nullable="true"/></column>
            <column name="course_version" type="bigint"><constraints nullable="false"/></column>
            <column name="status" type="varchar(20)"><constraints nullable="false"/></column>
            <column name="submission_note" type="varchar(5000)"><constraints nullable="true"/></column>
            <column name="rights_confirmed_at" type="${datetimeType}"><constraints nullable="false"/></column>
            <column name="submitted_at" type="${datetimeType}"><constraints nullable="false"/></column>
            <column name="reviewed_at" type="${datetimeType}"><constraints nullable="true"/></column>
            <column name="reviewer_feedback" type="varchar(5000)"><constraints nullable="true"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="course_review_requests" baseColumnNames="course_id" referencedTableName="course" referencedColumnNames="id" constraintName="fk_review_request_course"/>
        <addForeignKeyConstraint baseTableName="course_review_requests" baseColumnNames="submitted_by_id" referencedTableName="jhi_user" referencedColumnNames="id" constraintName="fk_review_request_submitted_by"/>
        <addForeignKeyConstraint baseTableName="course_review_requests" baseColumnNames="reviewed_by_id" referencedTableName="jhi_user" referencedColumnNames="id" constraintName="fk_review_request_reviewed_by"/>
        <createIndex tableName="course_review_requests" indexName="idx_review_requests_course"><column name="course_id"/></createIndex>
        <createIndex tableName="course_review_requests" indexName="idx_review_requests_status"><column name="status"/></createIndex>
    </changeSet>
</databaseChangeLog>
