<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Question.
    -->
    <changeSet id="20261012230501-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="bank_id"
                                 baseTableName="questions"
                                 constraintName="fk_questions__bank_id"
                                 referencedColumnNames="id"
                                 referencedTableName="question_banks"
                                 />

        <addForeignKeyConstraint baseColumnNames="created_by_id"
                                 baseTableName="questions"
                                 constraintName="fk_questions__created_by_id"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_user"
                                 />

        <addForeignKeyConstraint baseColumnNames="ai_content_id"
                                 baseTableName="questions"
                                 constraintName="fk_questions__ai_content_id"
                                 referencedColumnNames="id"
                                 referencedTableName="ai_generated_contents"
                                 />

        <addForeignKeyConstraint baseColumnNames="subject_id"
                                 baseTableName="questions"
                                 constraintName="fk_questions__subject_id"
                                 referencedColumnNames="id"
                                 referencedTableName="subjects"
                                 />

        <addForeignKeyConstraint baseColumnNames="grade_id"
                                 baseTableName="questions"
                                 constraintName="fk_questions__grade_id"
                                 referencedColumnNames="id"
                                 referencedTableName="grades"
                                 />

        <addForeignKeyConstraint baseColumnNames="previous_question_id"
                                 baseTableName="questions"
                                 constraintName="fk_questions__previous_question_id"
                                 referencedColumnNames="id"
                                 referencedTableName="questions"
                                 />
    </changeSet>
</databaseChangeLog>
