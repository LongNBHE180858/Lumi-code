<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity CourseEnrollment.
    -->
    <changeSet id="20261012230445-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="course_id"
                                 baseTableName="course_enrollments"
                                 constraintName="fk_course_enrollments__course_id"
                                 referencedColumnNames="id"
                                 referencedTableName="courses"
                                 />

        <addForeignKeyConstraint baseColumnNames="student_id"
                                 baseTableName="course_enrollments"
                                 constraintName="fk_course_enrollments__student_id"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_user"
                                 />

        <addForeignKeyConstraint baseColumnNames="last_accessed_lesson_id"
                                 baseTableName="course_enrollments"
                                 constraintName="fk_course_enrollments__last_accessed_lesson_id"
                                 referencedColumnNames="id"
                                 referencedTableName="lessons"
                                 />
    </changeSet>
</databaseChangeLog>
