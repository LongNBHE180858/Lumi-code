<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Discussion.
    -->
    <changeSet id="20261012230521-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="lesson_id"
                                 baseTableName="discussions"
                                 constraintName="fk_discussions__lesson_id"
                                 referencedColumnNames="id"
                                 referencedTableName="lessons"
                                 />

        <addForeignKeyConstraint baseColumnNames="student_id"
                                 baseTableName="discussions"
                                 constraintName="fk_discussions__student_id"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_user"
                                 />

        <addForeignKeyConstraint baseColumnNames="study_class_id"
                                 baseTableName="discussions"
                                 constraintName="fk_discussions__study_class_id"
                                 referencedColumnNames="id"
                                 referencedTableName="classes"
                                 />
    </changeSet>
</databaseChangeLog>
