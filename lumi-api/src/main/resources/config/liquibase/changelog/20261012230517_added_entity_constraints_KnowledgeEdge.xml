        <addForeignKeyConstraint baseColumnNames="to_node_id"
                                 baseTableName="knowledge_edges"
                                 constraintName="fk_knowledge_edges__to_node_id"
                                 referencedColumnNames="id"
                                 referencedTableName="knowledge_nodes"
                                 />
    </changeSet>
</databaseChangeLog>
