<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity ExamAnswer.
    -->
    <changeSet id="20261012230508-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="attempt_id"
                                 baseTableName="exam_answers"
                                 constraintName="fk_exam_answers__attempt_id"
                                 referencedColumnNames="id"
                                 referencedTableName="exam_attempts"
                                 />

        <addForeignKeyConstraint baseColumnNames="question_id"
                                 baseTableName="exam_answers"
                                 constraintName="fk_exam_answers__question_id"
                                 referencedColumnNames="id"
                                 referencedTableName="questions"
                                 />

        <addForeignKeyConstraint baseColumnNames="option_id"
                                 baseTableName="exam_answers"
                                 constraintName="fk_exam_answers__option_id"
                                 referencedColumnNames="id"
                                 referencedTableName="question_options"
                                 />
    </changeSet>
</databaseChangeLog>
