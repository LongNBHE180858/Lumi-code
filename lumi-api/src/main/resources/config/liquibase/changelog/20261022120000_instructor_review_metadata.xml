<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261022120000-1" author="lumi">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="user_profiles" columnName="instructor_rejection_reason"/>
            </not>
        </preConditions>
        <addColumn tableName="user_profiles">
            <column name="instructor_rejection_reason" type="varchar(2000)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20261022120000-2" author="lumi">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="user_profiles" columnName="instructor_reviewed_at"/>
            </not>
        </preConditions>
        <addColumn tableName="user_profiles">
            <column name="instructor_reviewed_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
