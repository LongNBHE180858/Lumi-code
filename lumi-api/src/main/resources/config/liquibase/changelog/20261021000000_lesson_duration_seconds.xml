<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="20261021000000-1" author="codex">
        <addColumn tableName="lesson">
            <column name="duration_seconds" type="integer"/>
        </addColumn>
        <sql>UPDATE lesson SET duration_seconds = duration_minutes * 60 WHERE duration_minutes IS NOT NULL AND duration_minutes &lt;= 35791394</sql>
    </changeSet>
</databaseChangeLog>
