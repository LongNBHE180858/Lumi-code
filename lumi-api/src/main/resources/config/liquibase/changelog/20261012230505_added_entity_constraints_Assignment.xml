    <!--
        Added the constraints for entity Assignment.
    -->
    <changeSet id="20261012230505-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="study_class_id"
                                 baseTableName="assignments"
                                 constraintName="fk_assignments__study_class_id"
                                 referencedColumnNames="id"
