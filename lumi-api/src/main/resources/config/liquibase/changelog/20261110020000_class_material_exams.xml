<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="20261110020000-1" author="lumi">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="exams" columnName="class_material_id"/></not>
        </preConditions>
        <addColumn tableName="exams">
            <column name="class_material_id" type="bigint"/>
        </addColumn>
    </changeSet>
    <changeSet id="20261110020000-2" author="lumi">
        <preConditions onFail="MARK_RAN">
            <not><foreignKeyConstraintExists foreignKeyName="fk_exams_class_material_id"/></not>
        </preConditions>
        <addForeignKeyConstraint baseTableName="exams" baseColumnNames="class_material_id"
                                 referencedTableName="class_materials" referencedColumnNames="id"
                                 constraintName="fk_exams_class_material_id"/>
    </changeSet>
</databaseChangeLog>
